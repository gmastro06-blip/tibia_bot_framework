{
  "version": 1,
  "overlay_preset": "Custom",
  "telemetry_preset": "Custom",
  "overlay": {
    "enabled": true,
    "out_dir": "logs/debug_overlay",
    "interval_s": 1.0,
    "tile_grid": true,
    "tile_px": 32,
    "rois": "coords_ocr,minimap_content,hp_top_ocr,mp_top_ocr,hp_low_bar,mp_low_bar,states_icons,equipment_slots,battlelist_rows"
  },
  "healing": {
    "enabled": true,
    "hp_below_pct": 90,
    "hp_recover_pct": 80,
    "mp_below_pct": 30,
    "mp_recover_pct": 50,
    "action": "",
    "hp_action": "F2",
    "mp_action": "",
    "cooldown_s": 1.0
  },
  "cavebot": {
    "enabled": true,
    "route_path": "configs/route.json",
    "mode": "steps",
    "coords_provider": "disabled",
    "minimap_seed_x": "",
    "minimap_seed_y": "",
    "minimap_seed_z": "",
    "minimap_fallback_mode": "steps",
    "minimap_fallback_conf_threshold": 0.4,
    "minimap_fallback_n_ticks": 4,
    "loop": true,
    "stop_on_low_cap": true,
    "cap_threshold": 50,
    "stop_on_low_potions": false,
    "potions_remaining": 0,
    "potions_min": 0,
    "recovery_enabled": true,
    "recovery_idle_s": 0.0,
    "recovery_max_attempts": 4,
    "recovery_stop_on_fail": false
  },
  "simulation": {
    "enabled": true,
    "paralyzed": true,
    "haste_active": true,
    "utamo_active": true,
    "hungry": true
  },
  "assistant": {
    "enabled": true,
    "confirm_actions": false,
    "sound_alerts": true,
    "input_mode": "keyboard",
    "target_hotkey": "PGDN",
    "minimap_hotkey": "",
    "live_input_armed": true,
    "auto_arm_on_cavebot_start": true,
    "auto_arm_no_confirm": true,
    "allowed_window_titles": [
      "Tibia",
      "TibiaClone",
      "MyClient"
    ]
  },
  "battlelist_targeting": {
    "autotarget_enabled": true,
    "alive_threshold": 0.5,
    "dead_debounce_frames": 6,
    "select_debounce_frames": 3,
    "scroll_cooldown_ms": 800,
    "target_cooldown_ms": 500,
    "ocr_names": false
  },
  "replay": {
    "enabled": false,
    "interval_ms": 2000,
    "out_dir": "logs/replay"
  },
  "logging": {
    "enabled": true,
    "interval_ms": 250,
    "out_file": "logs/telemetry.jsonl"
  },
  "idle": {
    "alert_s": 0.0,
    "repeat_s": 10.0,
    "ui_fail_s": 0.0
  },
  "rois": {
    "config_override": ""
  }
}